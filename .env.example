# ---------------------------------------------------------------------------
# ProdEx configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Source of documents --------------------------------------------------
# mock  = use the bundled fixtures/repo content (no credentials needed)
# github = pull from the GitHub App (needs the GitHub block below)
GITHUB_SOURCE=mock
GITHUB_REPOS=acme/prodex-core,acme/prodex-docs
GITHUB_BRANCH=main
INDEX_CODE=false

# --- GitHub App (read-only) ----------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Dev-only escape hatch when GITHUB_SOURCE=github and no App exists yet.
GITHUB_TOKEN=

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://prodex:prodex@db:5432/prodex
METABASE_DB_URL=postgresql://metabase_ro:change_me@db:5432/prodex

# --- Models ---------------------------------------------------------------
# Everything here speaks the OpenAI-compatible /v1 API, so one set of settings
# covers local Ollama, vLLM, LM Studio, Grok, NVIDIA NIM and OpenAI.
#
# SECURITY (spec 14.8): whether a request leaves this machine is decided from the
# HOST in the URL, not from a flag. Point LLM_BASE_URL at a remote host without
# setting ALLOW_EXTERNAL_PROVIDERS=true and the app refuses to start. That way
# you cannot accidentally ship your documentation to a third party.

ALLOW_EXTERNAL_PROVIDERS=false

# ---------- LLM ----------
# LOCAL (default, nothing leaves the machine):
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=ollama
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=300

# HOSTED alternatives. Pick one block, comment out the others, and set
# ALLOW_EXTERNAL_PROVIDERS=true. Expect ~2-5s answers instead of 40-200s.
#
#   # Grok (x.ai)
#   LLM_BASE_URL=https://api.x.ai/v1
#   LLM_MODEL=grok-2-latest
#   LLM_API_KEY=xai-...
#
#   # NVIDIA NIM
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=meta/llama-3.3-70b-instruct
#   LLM_API_KEY=nvapi-...
#
#   # OpenAI
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-...
#
#   # Local vLLM (GPU box) - stays local, no opt-in needed
#   LLM_BASE_URL=http://vllm:8000/v1
#   LLM_MODEL=your-model-name
#   LLM_API_KEY=anything

# ---------- Embeddings ----------
# Local is fast enough (384 dims, ~130 MB) and keeps the index content on the
# machine, so this one rarely needs changing.
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Only read when EMBED_PROVIDER=openai_compatible:
#   EMBED_BASE_URL=https://api.openai.com/v1
#   EMBED_API_KEY=sk-...
#   EMBED_MODEL=text-embedding-3-small
#   EMBED_DIM=1536
EMBED_BASE_URL=
EMBED_API_KEY=

# ---------- Reranker ----------
# Always local. A cross-encoder is not an OpenAI-compatible API, the model is
# only ~1.1 GB, and it costs a couple of seconds - not worth the integration.
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-base

# --- Retrieval ------------------------------------------------------------
TOP_K_RETRIEVE=20
TOP_K_KEYWORD=20
RRF_K=60
TOP_K_FINAL=5
MIN_RERANK_SCORE=0.30

# --- Chunking -------------------------------------------------------------
CHUNK_MIN_TOKENS=100
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_RATIO=0.12
SUMMARIZE_ISSUE_THREADS=true

# --- Slack ----------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_CHANNELS=
ESCALATION_CHANNEL=
OWNER_HINT="the product owner"

# --- API / ops ------------------------------------------------------------
INTERNAL_API_KEY=change-me-generate-a-long-random-value
LOG_RETENTION_DAYS=180

# --- Metabase -------------------------------------------------------------
METABASE_PORT=3000