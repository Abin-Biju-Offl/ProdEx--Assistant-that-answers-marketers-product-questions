# ---------------------------------------------------------------------------
# ProdEx configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Source of documents --------------------------------------------------
# mock  = use the bundled fixtures/repo content (no credentials needed)
# github = pull from the GitHub App (needs the GitHub block below)
GITHUB_SOURCE=mock
GITHUB_REPOS=acme/prodex-core,acme/prodex-docs
GITHUB_BRANCH=main
INDEX_CODE=false

# --- GitHub App (read-only) ----------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Dev-only escape hatch when GITHUB_SOURCE=github and no App exists yet.
GITHUB_TOKEN=

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://prodex:prodex@db:5432/prodex
METABASE_DB_URL=postgresql://metabase_ro:change_me@db:5432/prodex

# --- Models ---------------------------------------------------------------
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=ollama
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120

EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Only read when EMBED_PROVIDER=openai, which also needs ALLOW_EXTERNAL_PROVIDERS=true
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=

RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-base

# Hard security switch (spec section 14.8). Any external provider is refused
# while this is false, even if EMBED_PROVIDER/RERANK_PROVIDER are set to it.
ALLOW_EXTERNAL_PROVIDERS=false

# --- Retrieval ------------------------------------------------------------
TOP_K_RETRIEVE=20
TOP_K_KEYWORD=20
RRF_K=60
TOP_K_FINAL=5
MIN_RERANK_SCORE=0.30

# --- Chunking -------------------------------------------------------------
CHUNK_MIN_TOKENS=100
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_RATIO=0.12
SUMMARIZE_ISSUE_THREADS=true

# --- Slack ----------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_CHANNELS=
ESCALATION_CHANNEL=
OWNER_HINT="the product owner"

# --- API / ops ------------------------------------------------------------
INTERNAL_API_KEY=change-me-generate-a-long-random-value
LOG_RETENTION_DAYS=180

# --- Metabase -------------------------------------------------------------
METABASE_PORT=3000